{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kerasoni",
  "main": "worker/index.ts",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "NODE_ENV": "production"
  },
  "observability": {
    "enabled": true
  }
}
